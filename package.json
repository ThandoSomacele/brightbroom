{
  "name": "brightbroom",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "analyze": "vite build --mode=analyze",
    "lint": "eslint . --ext .ts,.js,.svelte --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.js,.svelte --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:rebaseline": "tsx scripts/db/rebaseline-migrations.ts",
    "db:generate": "drizzle-kit generate --schema=./src/lib/server/db/schema.ts --out=./drizzle/migrations --dialect=postgresql",
    "db:studio": "drizzle-kit studio",
    "db:fresh:generate": "drizzle-kit generate --config drizzle.fresh.config.ts",
    "db:fresh:migrate": "drizzle-kit migrate --config drizzle.fresh.config.ts",
    "db:seed:client": "tsx scripts/db/seed-client.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:seed:services": "tsx scripts/db/seed.ts services",
    "db:seed:users": "tsx scripts/db/seed.ts users",
    "db:seed:earnings": "tsx scripts/db/seed-earnings.ts",
    "db:seed:applications": "tsx scripts/db/seed-applications.ts",
    "db:seed:coupons": "tsx scripts/db/seed-coupons.ts",
    "db:seed:tenants": "tsx scripts/db/seed-tenants.ts",
    "db:migrate:training": "tsx scripts/db/migrate-training.ts",
    "db:backup": "tsx scripts/db/backup.ts",
    "db:backup:full": "tsx scripts/db/backup.ts --full",
    "db:introspect": "tsx scripts/db/introspect-prod.ts",
    "db:deduplicate": "tsx scripts/deduplicate-addresses.ts",
    "services:update": "tsx scripts/services/update.ts",
    "services:update:sort": "tsx scripts/services/update.ts --sort-order",
    "services:update:details": "tsx scripts/services/update.ts --details",
    "services:convert": "tsx scripts/services/convert.ts",
    "update:address-coordinates": "tsx scripts/update-address-coordinates.ts",
    "update:cleaner-coordinates": "tsx scripts/update-cleaner-coordinates.ts",
    "deploy:check": "node scripts/deploy/pre-deploy.js",
    "deploy:netlify": "node scripts/deploy/netlify.js",
    "deploy:validate-env": "node scripts/deploy/validate-env.js",
    "setup": "node scripts/setup.js",
    "test": "vitest",
    "dev:debug": "DEBUG=* vite dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@phosphor-icons/web": "^2.1.2",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/adapter-netlify": "^5.2.4",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/svelte": "^5.4.2",
    "@types/mime-types": "^2.1.4",
    "@types/sharp": "^0.31.1",
    "autoprefixer": "^10.6.2",
    "chalk": "^5.6.2",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.30.6",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.24.1",
    "gray-matter": "^4.0.3",
    "ioredis": "^6.0.0",
    "jsdom": "^26.1.0",
    "lucia": "^3.2.2",
    "marked": "^15.0.12",
    "mime-types": "^2.1.35",
    "nanoid": "^5.1.16",
    "node-fetch": "^3.3.2",
    "oslo": "^1.2.1",
    "papaparse": "^5.7.1",
    "postcss": "^8.5.33",
    "postgres": "^3.4.9",
    "posthog-js": "^1.450.0",
    "posthog-node": "^5.74.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^4.8.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-imagetools": "^7.1.1",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "svelte-check": {
    "detailed": true
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.8",
    "@types/google.maps": "^3.66.10",
    "@types/marked": "^5.0.2",
    "globals": "^16.5.0",
    "vite": "^6.4.6"
  }
}
